{
  "name": "ops-console-api",
  "version": "0.1.0",
  "private": true,
  "description": "Ops Console API: auth, users, roles, sessions, audit log, EC2 instances via SSM",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.14.1"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "migrate": "node dist/cli.js migrate",
    "test": "tsc -p . && node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@aws-sdk/client-cost-explorer": "3.967.0",
    "@aws-sdk/client-dlm": "3.967.0",
    "@aws-sdk/client-ec2": "3.967.0",
    "@aws-sdk/client-route-53": "3.967.0",
    "@aws-sdk/client-s3": "3.967.0",
    "@aws-sdk/client-scheduler": "3.967.0",
    "@aws-sdk/client-sesv2": "3.967.0",
    "@aws-sdk/client-ssm": "3.967.0",
    "@aws-sdk/client-sts": "3.967.0",
    "@aws-sdk/s3-request-presigner": "3.967.0",
    "@hono/node-server": "1.19.19",
    "hono": "4.13.18",
    "pg": "8.23.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "8.5.12",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "~5.5.4"
  },
  "overrides": {
    "@aws-sdk/util-locate-window": "3.965.0"
  }
}
