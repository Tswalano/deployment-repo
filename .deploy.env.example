# Copy to .deploy.env (git-ignored) for local runs of ./deploy.sh
DEPLOY_HOST=lendifyapi.glenify.studio
DEPLOY_USER=ec2-user
# Option A — SSH key
# DEPLOY_SSH_KEY=~/Downloads/test-api.pem
# Option B — EC2 Instance Connect using your AWS CLI credentials (no .pem needed)
EC2_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx   # aws ec2 describe-instances --filters Name=tag:Name,Values=lendify-instance
AWS_REGION=af-south-1
