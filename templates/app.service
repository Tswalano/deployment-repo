# /etc/systemd/system/<SERVICE>.service — template for a new project
# Install:  sudo cp <SERVICE>.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now <SERVICE>
[Unit]
Description=<Human readable name>
Wants=network-online.target
Requires=app-secrets@<SERVICE>.service
After=network-online.target postgresql.service app-secrets@<SERVICE>.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/apps/<repo>/<APP_SUBDIR>
Environment=NODE_ENV=production PORT=<PORT>
# Secrets: never in this file. Store them in SSM Parameter Store under /apps/<SERVICE>/<KEY>
# (see README → Secrets); app-secrets@<SERVICE>.service loads them into a root-only tmpfs file first.
EnvironmentFile=/run/app-secrets/<SERVICE>.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
# Treat SIGTERM (exit 143) as a clean stop so scheduled shutdowns aren't logged as failures
SuccessExitStatus=143
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
