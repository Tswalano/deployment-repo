# app-secrets@<service> — managed by deployment-repo (systemd/app-secrets@.service)
# Fetches SSM /apps/<service>/* into /run/app-secrets/<service>.env BEFORE <service> starts.
# (systemd reads EnvironmentFile= before ExecStartPre=, so the loader must be a separate unit.)
# PartOf: restarting/stopping <service> restarts/stops this too → secrets are re-read on every restart.
[Unit]
Description=Load %i secrets from SSM Parameter Store
Wants=network-online.target
After=network-online.target
PartOf=%i.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/load-app-secrets %i
# don't leave plaintext in /run while the app is stopped
ExecStop=/bin/rm -f /run/app-secrets/%i.env
