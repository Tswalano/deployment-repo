# FinanceFlow API — managed by deployment-repo (systemd/app1.service)
# Secrets: SSM /apps/app1/* loaded by app-secrets@app1.service  →  /run/app-secrets/app1.env
[Unit]
Description=FinanceFlow Hono (Node)
Wants=network-online.target
Requires=app-secrets@app1.service
After=network-online.target postgresql.service app-secrets@app1.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/apps/app1/backend
Environment=PORT=3000 NODE_ENV=production
EnvironmentFile=/run/app-secrets/app1.env
ExecStart=/usr/bin/env bash -lc 'npm run dev'
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
