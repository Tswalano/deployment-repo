# LiftParcel API — managed by deployment-repo (systemd/liftparcel.service)
# Secrets: SSM /apps/liftparcel/* loaded by app-secrets@liftparcel.service  →  /run/app-secrets/liftparcel.env
[Unit]
Description=LiftParcel API (Node)
Wants=network-online.target
Requires=app-secrets@liftparcel.service
After=network-online.target postgresql.service app-secrets@liftparcel.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/apps/liftparcel/api
Environment=PORT=4000 NODE_ENV=production
EnvironmentFile=/run/app-secrets/liftparcel.env
# ts-node in transpile-only mode: no type-checking at runtime (~200 MB RSS instead of ~480 MB).
# A full `tsc` build peaks at ~775 MB, which can't run on this 1 GB box next to the apps, so there
# is no build step; type-checking happens on developer machines / PR checks instead.
Environment=TS_NODE_TRANSPILE_ONLY=true
ExecStart=/usr/bin/node node_modules/.bin/ts-node lambda/dev.ts
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
