# Lendify API — managed by deployment-repo (systemd/lendify.service)
# Secrets: SSM /apps/lendify/* loaded by app-secrets@lendify.service  →  /run/app-secrets/lendify.env
[Unit]
Description=Lendify API (Hono/Node)
Wants=network-online.target
Requires=app-secrets@lendify.service
After=network-online.target postgresql.service app-secrets@lendify.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/lendify
Environment=PORT=8088 NODE_ENV=production
# Email via Amazon SES using the instance role (no SMTP credentials). Needs the
# send-email-as-lendify IAM policy (scripts/setup-aws-iam.sh) and SES production access.
Environment=EMAIL_TRANSPORT=ses SES_FROM_EMAIL=lendify@glenify.studio SES_REGION=af-south-1
EnvironmentFile=/run/app-secrets/lendify.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
