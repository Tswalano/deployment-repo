{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListParameterNamesAndDatesOnly",
      "Effect": "Allow",
      "Action": "ssm:DescribeParameters",
      "Resource": "*"
    },
    {
      "Sid": "WriteAppParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:DeleteParameter"
      ],
      "Resource": "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/apps/*"
    },
    {
      "Sid": "ConsoleOwnSettings",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:PutParameter",
        "ssm:DeleteParameter"
      ],
      "Resource": "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/ops-console/*"
    },
    {
      "Sid": "NeverTheConsolesOwnParameters",
      "Effect": "Deny",
      "Action": [
        "ssm:PutParameter",
        "ssm:DeleteParameter"
      ],
      "Resource": [
        "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/apps/ops-console/*",
        "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/apps/ops-dashboard/*",
        "arn:aws:ssm:*:${ACCOUNT_ID}:parameter/apps/ops-dashboard-auth/*"
      ]
    },
    {
      "Sid": "EncryptSecureStringsViaSSMOnly",
      "Effect": "Allow",
      "Action": "kms:Encrypt",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "kms:ViaService": "ssm.*.amazonaws.com"
        }
      }
    }
  ]
}
