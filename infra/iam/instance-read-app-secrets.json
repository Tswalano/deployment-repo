{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppParameters",
      "Effect": "Allow",
      "Action": ["ssm:GetParametersByPath", "ssm:GetParameters", "ssm:GetParameter"],
      "Resource": [
        "arn:aws:ssm:af-south-1:${ACCOUNT_ID}:parameter/apps",
        "arn:aws:ssm:af-south-1:${ACCOUNT_ID}:parameter/apps/*"
      ]
    },
    {
      "Sid": "DecryptSecureStringsViaSSMOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.af-south-1.amazonaws.com" } }
    }
  ]
}
